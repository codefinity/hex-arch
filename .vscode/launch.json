{
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Launch HexArch API",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/server/src/driving-adapters/HexArch.API/bin/Debug/net10.0/HexArch.API.dll",
            "cwd": "${workspaceFolder}/server/src/driving-adapters/HexArch.API",
            "stopAtEntry": false,
            "justMyCode": true,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5126"
            },
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s/swagger"
            },
            "preLaunchTask": "build HexArch API"
        }
    ]
}