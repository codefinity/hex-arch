{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "Persistence": {
    "Provider": "Postgres"
  },
  "Observability": {
    "Enabled": true,
    "ServiceName": "hexarch-api",
    "OtlpEndpoint": "http://localhost:4317",
    "TraceSamplingRatio": 1.0
  },
  "ConnectionStrings": {
    "IdentityAccess": "Host=localhost;Database=hexarch;Username=postgres;Password=admin",
    "IdentityAccessMongoDb": "mongodb://localhost:27017/hexarch"
  },
  "Jwt": {
    "SigningKey": "REPLACE_WITH_A_SECRET_AT_LEAST_32_CHARS_LONG",
    "Issuer": "HexArch",
    "Audience": "HexArch",
    "ExpiryMinutes": 60
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "From": "REPLACE_WITH_YOUR_GMAIL_ADDRESS@gmail.com",
    "Username": "REPLACE_WITH_YOUR_GMAIL_ADDRESS@gmail.com",
    "Password": "REPLACE_WITH_YOUR_GMAIL_APP_PASSWORD"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "ExchangePrefix": "hexarch",
    "ApplicationName": "hexarch-api",
    "DeclareTopologyOnStartup": true,
    "PublishTimeoutSeconds": 5,
    "ConnectRetryCooldownSeconds": 30
  }
}