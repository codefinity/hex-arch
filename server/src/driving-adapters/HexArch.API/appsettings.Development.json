{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Persistence": {
    "Provider": "MongoDb"
  },
  "ConnectionStrings": {
    "IdentityAccess": "Host=localhost;Database=hexarch;Username=postgres;Password=admin",
    "IdentityAccessMongoDb": "mongodb://localhost:27017/hexarch"
  },
  "Jwt": {
    "SigningKey": "REPLACE_WITH_A_SECRET_AT_LEAST_32_CHARS_LONG",
    "Issuer": "HexArch",
    "Audience": "HexArch",
    "ExpiryMinutes": 60
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "From": "noreply@hexarch.local",
    "Username": "",
    "Password": ""
  },
  "RabbitMq": {
    "HostName": "localhost",
    "UserName": "admin",
    "Password": "admin",
    "ExchangePrefix": "hexarch",
    "ConnectRetryCooldownSeconds": 5
  }
}